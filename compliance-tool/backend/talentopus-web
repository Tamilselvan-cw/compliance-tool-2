########## TALENTOPUS WEB APP ##########

# HTTP → HTTPS redirect for talentopus subdomain(s)
server {
    listen 80;
    listen [::]:80;
    server_name talentopus.codewents.com *.talentopus.codewents.com;

    return 301 https://$host$request_uri;
}

# HTTPS (React build for talentopus)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name talentopus.codewents.com *.talentopus.codewents.com;

    add_header X-Site talentopus-web always;

    # SSL certs for Talentopus domain
    ssl_certificate     /etc/letsencrypt/live/talentopus.codewents.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/talentopus.codewents.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /var/www/talentopus/frontend/build;
    index index.html;

    location = /health {
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # Static assets (long cache)
    location ~* \.(?:js|mjs|css|svg|ico|png|jpg|jpeg|gif|webp|woff2?)$ {
        try_files $uri =404;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store";
    }

    access_log /var/log/nginx/talentopus-web_access.log;
    error_log  /var/log/nginx/talentopus-web_error.log;
}
